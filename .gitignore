# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# python caches (deploy scripts)
__pycache__/
*.pyc

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# release signing secrets (passwords) — NEVER commit
keystore.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# local build/test artifacts
/artifacts/
gradle-build*.log

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Firebase / FCM credentials (NEVER commit the service-account key)
google-services.json
GoogleService-Info.plist
*firebase-adminsdk*.json
fcm-*.json
service-account*.json

# typescript
*.tsbuildinfo

example

# generated native folders
# /android is committed (bare workflow) to keep the Windows local-build overrides
# and release signing config reproducible; its own android/.gitignore excludes build
# artifacts, and the rules above exclude secrets (*.jks, keystore.properties,
# google-services.json). /ios stays generated via `expo prebuild`.
/ios
